# Example environment variables; never add secrets here.
ELEMENTAL_KEEP_API_BASE_URL=http://127.0.0.1:8000
ELEMENTAL_API_DB_PATH=./.local/elemental_api.db
# Leave blank to generate a new admin token whenever the API container starts.
ELEMENTAL_API_ADMIN_TOKEN=
ELEMENTAL_DATA_DIR=./.local
ELEMENTAL_MATCH_LIMIT=100
ELEMENTAL_MATCH_JOIN_TIMEOUT_SECONDS=120
